{
    "namespace": "daily_rewards",

    "daily_rewards_form": {
        "type": "panel",
        "size": [ "100%", "100%" ],
        "controls": [
            {
                "screen_dim": {
                    "type": "image",
                    "texture": "textures/ui/Black",
                    "alpha": 0.86,
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "offset": [ 0, 0 ],
                    "size": [ 10000, 10000 ],
                    "layer": -100
                }
            },
            {
                "screen_dim_softener": {
                    "type": "image",
                    "texture": "textures/ui/hud_tip_text_background",
                    "alpha": 0.35,
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "offset": [ 0, 0 ],
                    "size": [ 10000, 10000 ],
                    "layer": -99
                }
            },
            {
                "title": {
                    "type": "label",
                    "text": "Daily Rewards",
                    "color": [ 1, 0.72, 0.15 ],
                    "font_type": "MinecraftTen",
                    "font_scale_factor": 1.35,
                    "shadow": true,
                    "text_alignment": "center",
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [ 0, 34 ],
                    "size": [ "100%", 24 ],
                    "layer": 10
                }
            },
            {
                "subtitle": {
                    "type": "label",
                    "text": "Choose one card to claim today's reward",
                    "color": [ 1, 0.84, 0.38 ],
                    "font_type": "MinecraftTen",
                    "font_scale_factor": 0.82,
                    "shadow": true,
                    "text_alignment": "center",
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [ 0, 64 ],
                    "size": [ "100%", 18 ],
                    "layer": 10
                }
            },
            {
                "content_panel": {
                    "type": "panel",
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "offset": [ 0, -2 ],
                    "size": [ 520, 146 ],
                    "layer": 10,
                    "controls": [
                        {
                            "cards@daily_rewards.daily_rewards_cards": {}
                        },
                        {
                            "close_button@common.close_button": {
                                "size": [ 16, 16 ],
                                "offset": [ 0, -14 ],
                                "anchor_from": "top_right",
                                "anchor_to": "top_right",
                                "controls": [
                                    {
                                        "default@common.close_button_panel": {
                                            "type": "image",
                                            "$close_button_texture": "textures/ui/credits_close_d",
                                            "size": [ "100%", "100%" ]
                                        }
                                    },
                                    {
                                        "hover@common.close_button_panel": {
                                            "type": "image",
                                            "$close_button_texture": "textures/ui/credits_close_h",
                                            "size": [ "100%", "100%" ]
                                        }
                                    },
                                    {
                                        "pressed@common.close_button_panel": {
                                            "type": "image",
                                            "$close_button_texture": "textures/ui/credits_close_p",
                                            "size": [ "100%", "100%" ]
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            },
            {
                "streak_text": {
                    "type": "label",
                    "text": "#form_text",
                    "color": "white",
                    "font_type": "MinecraftTen",
                    "font_scale_factor": 0.9,
                    "shadow": true,
                    "text_alignment": "center",
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "offset": [ 0, 92 ],
                    "size": [ 260, 22 ],
                    "layer": 10
                }
            }
        ],
        "bindings": [
            {
                "binding_name": "#title_text"
            },
            {
                "binding_type": "view",
                "source_property_name": "(not ((#title_text - '§❖§D§R') = #title_text))",
                "target_property_name": "#visible"
            }
        ]
    },

    "daily_rewards_cards": {
        "type": "stack_panel",
        "orientation": "horizontal",
        "anchor_from": "center",
        "anchor_to": "center",
        "offset": [ 0, 0 ],
        "size": [ "100%c", 112 ],
        "layer": 1,
        "factory": {
            "name": "buttons",
            "control_name": "daily_rewards.reward_card"
        },
        "collection_name": "form_buttons",
        "bindings": [
            {
                "binding_name": "#form_button_contents",
                "binding_name_override": "#collection_length"
            }
        ]
    },

    "reward_card": {
        "type": "panel",
        "size": [ 72, 112 ],
        "controls": [
            {
                "card_button@common.button": {
                    "$pressed_button_name": "button.form_button_click",
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "size": [ 64, 102 ],
                    "bindings": [
                        {
                            "binding_type": "collection_details",
                            "binding_collection_name": "form_buttons"
                        }
                    ],
                    "controls": [
                        {
                            "default@daily_rewards.card_default": {}
                        },
                        {
                            "hover@daily_rewards.card_hover": {}
                        },
                        {
                            "pressed@daily_rewards.card_pressed": {}
                        },
                        {
                            "inner_face": {
                                "type": "image",
                                "texture": "textures/ui/Black",
                                "color": [ 0.08, 0.08, 0.07 ],
                                "alpha": 0.82,
                                "anchor_from": "center",
                                "anchor_to": "center",
                                "offset": [ 0, -8 ],
                                "size": [ "82%", "62%" ],
                                "layer": 4
                            }
                        },
                        {
                            "icon_glow": {
                                "type": "image",
                                "texture": "textures/ui/hud_tip_text_background",
                                "color": [ 1, 0.72, 0.18 ],
                                "alpha": 0.22,
                                "anchor_from": "top_middle",
                                "anchor_to": "top_middle",
                                "offset": [ 0, 13 ],
                                "size": [ 40, 30 ],
                                "layer": 5
                            }
                        },
                        {
                            "reward_icon": {
                                "type": "image",
                                "texture": "#form_button_texture",
                                "anchor_from": "top_middle",
                                "anchor_to": "top_middle",
                                "offset": [ 0, 14 ],
                                "size": [ 29, 29 ],
                                "layer": 8,
                                "bindings": [
                                    {
                                        "binding_name": "#form_button_texture",
                                        "binding_name_override": "#texture",
                                        "binding_type": "collection",
                                        "binding_collection_name": "form_buttons"
                                    },
                                    {
                                        "binding_name": "#form_button_texture_file_system",
                                        "binding_name_override": "#texture_file_system",
                                        "binding_type": "collection",
                                        "binding_collection_name": "form_buttons"
                                    }
                                ]
                            }
                        },
                        {
                            "text_plate": {
                                "type": "image",
                                "texture": "textures/ui/hud_tip_text_background",
                                "alpha": 0.7,
                                "anchor_from": "bottom_middle",
                                "anchor_to": "bottom_middle",
                                "offset": [ 0, -15 ],
                                "size": [ "84%", 42 ],
                                "layer": 8
                            }
                        },
                        {
                            "card_text": {
                                "type": "label",
                                "text": "#form_button_text",
                                "color": "white",
                                "font_type": "MinecraftTen",
                                "font_scale_factor": 0.46,
                                "shadow": true,
                                "text_alignment": "center",
                                "anchor_from": "bottom_middle",
                                "anchor_to": "bottom_middle",
                                "offset": [ 0, -15 ],
                                "size": [ "100% - 8px", 40 ],
                                "layer": 10,
                                "bindings": [
                                    {
                                        "binding_name": "#form_button_text",
                                        "binding_type": "collection",
                                        "binding_collection_name": "form_buttons"
                                    }
                                ]
                            }
                        },
                        {
                            "claimed_overlay": {
                                "type": "image",
                                "texture": "textures/ui/Black",
                                "color": [ 0.55, 0.55, 0.55 ],
                                "alpha": 0.66,
                                "size": [ "100%", "100%" ],
                                "layer": 20,
                                "bindings": [
                                    {
                                        "binding_name": "#form_button_text",
                                        "binding_type": "collection",
                                        "binding_collection_name": "form_buttons"
                                    },
                                    {
                                        "binding_type": "view",
                                        "source_property_name": "(not ((#form_button_text - 'Claimed') = #form_button_text))",
                                        "target_property_name": "#visible"
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },

    "card_default": {
        "type": "image",
        "texture": "textures/ui/default_creditb",
        "color": [ 1, 0.88, 0.32 ],
        "alpha": 1,
        "size": [ "100%", "100%" ],
        "layer": 1
    },

    "card_hover": {
        "type": "image",
        "texture": "textures/ui/hover_creditb",
        "color": [ 0.26, 0.95, 1 ],
        "alpha": 1,
        "size": [ "100%", "100%" ],
        "layer": 2
    },

    "card_pressed": {
        "type": "image",
        "texture": "textures/ui/pressed_creditb",
        "color": [ 0.92, 0.62, 0.18 ],
        "alpha": 1,
        "size": [ "100%", "100%" ],
        "layer": 3
    }
}
