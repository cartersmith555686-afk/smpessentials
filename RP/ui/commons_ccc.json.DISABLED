//You wanna know how it works huh ;)

{"\u006E\u0061\u006D\u0065\u0073\u0070\u0061\u0063\u0065":"\u0063\u0063\u0063","\u0063\u006F\u006D\u006D\u0061\u006E\u0064\u0073\u005F\u0073\u0074\u0061\u0063\u006B":{"\u0074\u0079\u0070\u0065":"\u0073\u0074\u0061\u0063\u006B\u005F\u0070\u0061\u006E\u0065\u006C","\u0073\u0069\u007A\u0065":["100%","100%c"],"\u006F\u0072\u0069\u0065\u006E\u0074\u0061\u0074\u0069\u006F\u006E":"\u0076\u0065\u0072\u0074\u0069\u0063\u0061\u006C","\u0024\u0062\u0072\u006F\u0061\u0064\u007C\u0064\u0065\u0066\u0061\u0075\u006C\u0074":true,"\u0024\u0063\u006F\u006D\u006D\u0061\u006E\u0064\u0073\u007C\u0064\u0065\u0066\u0061\u0075\u006C\u0074":[],"\u0063\u006F\u006E\u0074\u0072\u006F\u006C\u0073":"\u0024\u0063\u006F\u006D\u006D\u0061\u006E\u0064\u0073"},"\u0063\u0075\u0073\u0074\u006F\u006D\u005F\u0063\u006F\u006D\u006D\u0061\u006E\u0064\u005F\u0069\u0074\u0065\u006D\u005F\u006F\u0076\u0065\u0072\u0076\u0069\u0065\u0077":{"\u0074\u0079\u0070\u0065":"\u0070\u0061\u006E\u0065\u006C","\u0073\u0069\u007A\u0065":["100%","100%c"],"\u0024\u0063\u006F\u006D\u006D\u0061\u006E\u0064\u005F\u006C\u0065\u006E\u0067\u0074\u0068\u007C\u0064\u0065\u0066\u0061\u0075\u006C\u0074":4,"\u0024\u0063\u006F\u006D\u006D\u0061\u006E\u0064\u007C\u0064\u0065\u0066\u0061\u0075\u006C\u0074":"\u0074\u0065\u0073\u0074","\u0024\u0061\u0072\u0067\u0031\u007C\u0064\u0065\u0066\u0061\u0075\u006C\u0074":"","\u0024\u0061\u0072\u0067\u0032\u007C\u0064\u0065\u0066\u0061\u0075\u006C\u0074":"","\u0024\u0061\u0072\u0067\u0033\u007C\u0064\u0065\u0066\u0061\u0075\u006C\u0074":"","\u0063\u006F\u006E\u0074\u0072\u006F\u006C\u0073":[{"\u0062\u0072\u006F\u0061\u0064":{"\u0074\u0079\u0070\u0065":"\u0070\u0061\u006E\u0065\u006C","\u0073\u0069\u007A\u0065":["100%","100%c"],"\u0063\u006F\u006E\u0074\u0072\u006F\u006C\u0073":[{"\u0074\u0065\u0078\u0074":{"\u0074\u0079\u0070\u0065":"\u006C\u0061\u0062\u0065\u006C","\u006C\u006F\u0063\u0061\u006C\u0069\u007A\u0065":false,"\u0073\u0069\u007A\u0065":["100%","default"],"\u0024\u0063\u006F\u006D\u006D\u0061\u006E\u0064\u005F\u0077\u0069\u0074\u0068":"\u0028\u0024\u0063\u006F\u006D\u006D\u0061\u006E\u0064\u005F\u0070\u0072\u0065\u0066\u0069\u0078\u0020\u002B\u0020\u0024\u0063\u006F\u006D\u006D\u0061\u006E\u0064\u0029","\u0062\u0069\u006E\u0064\u0069\u006E\u0067\u0073":[{"\u0062\u0069\u006E\u0064\u0069\u006E\u0067\u005F\u0074\u0079\u0070\u0065":"\u0076\u0069\u0065\u0077","\u0073\u006F\u0075\u0072\u0063\u0065\u005F\u0063\u006F\u006E\u0074\u0072\u006F\u006C\u005F\u006E\u0061\u006D\u0065":"\u0074\u0065\u0078\u0074\u005F\u0062\u006F\u0078\u005F\u006D\u0065\u0073\u0073\u0061\u0067\u0065","\u0073\u006F\u0075\u0072\u0063\u0065\u005F\u0070\u0072\u006F\u0070\u0065\u0072\u0074\u0079\u005F\u006E\u0061\u006D\u0065":"\u0023\u0069\u0074\u0065\u006D\u005F\u006E\u0061\u006D\u0065","\u0074\u0061\u0072\u0067\u0065\u0074\u005F\u0070\u0072\u006F\u0070\u0065\u0072\u0074\u0079\u005F\u006E\u0061\u006D\u0065":"\u0023\u0073\u0065\u0061\u0072\u0063\u0068"},{"\u0062\u0069\u006E\u0064\u0069\u006E\u0067\u005F\u0074\u0079\u0070\u0065":"\u0076\u0069\u0065\u0077","\u0073\u006F\u0075\u0072\u0063\u0065\u005F\u0070\u0072\u006F\u0070\u0065\u0072\u0074\u0079\u005F\u006E\u0061\u006D\u0065":"\u0023\u0064\u0065\u0066\u0061\u0075\u006C\u0074\u005F\u0073\u0065\u0061\u0072\u0063\u0068","\u0074\u0061\u0072\u0067\u0065\u0074\u005F\u0070\u0072\u006F\u0070\u0065\u0072\u0074\u0079\u005F\u006E\u0061\u006D\u0065":"\u0023\u0073\u0065\u0061\u0072\u0063\u0068","\u0062\u0069\u006E\u0064\u0069\u006E\u0067\u005F\u0063\u006F\u006E\u0064\u0069\u0074\u0069\u006F\u006E":"\u006F\u006E\u0063\u0065"},{"\u0062\u0069\u006E\u0064\u0069\u006E\u0067\u005F\u0074\u0079\u0070\u0065":"\u0076\u0069\u0065\u0077","\u0073\u006F\u0075\u0072\u0063\u0065\u005F\u0070\u0072\u006F\u0070\u0065\u0072\u0074\u0079\u005F\u006E\u0061\u006D\u0065":"\u0028\u006E\u006F\u0074\u0020\u0028\u0023\u0073\u0065\u0061\u0072\u0063\u0068\u0020\u003D\u0020\u0027\u0027\u0029\u0029","\u0074\u0061\u0072\u0067\u0065\u0074\u005F\u0070\u0072\u006F\u0070\u0065\u0072\u0074\u0079\u005F\u006E\u0061\u006D\u0065":"\u0023\u0069\u0073\u005F\u006E\u006F\u0074\u005F\u0065\u006D\u0070\u0074\u0079"},{"\u0062\u0069\u006E\u0064\u0069\u006E\u0067\u005F\u0074\u0079\u0070\u0065":"\u0076\u0069\u0065\u0077","\u0073\u006F\u0075\u0072\u0063\u0065\u005F\u0070\u0072\u006F\u0070\u0065\u0072\u0074\u0079\u005F\u006E\u0061\u006D\u0065":"\u0028\u006E\u006F\u0074\u0020\u0028\u0028\u0024\u0063\u006F\u006D\u006D\u0061\u006E\u0064\u005F\u0077\u0069\u0074\u0068\u0020\u002D\u0020\u0023\u0073\u0065\u0061\u0072\u0063\u0068\u0029\u0020\u003D\u0020\u0024\u0063\u006F\u006D\u006D\u0061\u006E\u0064\u005F\u0077\u0069\u0074\u0068\u0029\u0029","\u0074\u0061\u0072\u0067\u0065\u0074\u005F\u0070\u0072\u006F\u0070\u0065\u0072\u0074\u0079\u005F\u006E\u0061\u006D\u0065":"\u0023\u0069\u0073\u005F\u0062\u0065\u0069\u006E\u0067\u005F\u0073\u0065\u0061\u0072\u0063\u0068\u0065\u0064"},{"\u0062\u0069\u006E\u0064\u0069\u006E\u0067\u005F\u0074\u0079\u0070\u0065":"\u0076\u0069\u0065\u0077","\u0073\u006F\u0075\u0072\u0063\u0065\u005F\u0070\u0072\u006F\u0070\u0065\u0072\u0074\u0079\u005F\u006E\u0061\u006D\u0065":"\u0028\u0024\u0063\u006F\u006D\u006D\u0061\u006E\u0064\u005F\u0077\u0069\u0074\u0068\u0020\u003D\u0020\u0028\u0028\u0027\u0025\u002E\u0027\u0020\u002B\u0028\u0020\u0024\u0063\u006F\u006D\u006D\u0061\u006E\u0064\u005F\u006C\u0065\u006E\u0067\u0074\u0068\u0020\u002B\u0020\u0031\u0029\u0020\u002B\u0020\u0027\u0073\u0027\u0029\u0020\u002A\u0020\u0023\u0073\u0065\u0061\u0072\u0063\u0068\u0029\u0029","\u0074\u0061\u0072\u0067\u0065\u0074\u005F\u0070\u0072\u006F\u0070\u0065\u0072\u0074\u0079\u005F\u006E\u0061\u006D\u0065":"\u0023\u0069\u0073\u005F\u0065\u0071\u0075\u0061\u006C"},{"\u0062\u0069\u006E\u0064\u0069\u006E\u0067\u005F\u0074\u0079\u0070\u0065":"\u0076\u0069\u0065\u0077","\u0073\u006F\u0075\u0072\u0063\u0065\u005F\u0070\u0072\u006F\u0070\u0065\u0072\u0074\u0079\u005F\u006E\u0061\u006D\u0065":"\u0028\u0028\u0023\u0069\u0073\u005F\u0062\u0065\u0069\u006E\u0067\u005F\u0073\u0065\u0061\u0072\u0063\u0068\u0065\u0064\u0020\u006F\u0072\u0020\u0028\u006E\u006F\u0074\u0020\u0028\u0023\u0069\u0073\u005F\u006E\u006F\u0074\u005F\u0065\u006D\u0070\u0074\u0079\u0029\u0029\u0029\u0020\u0061\u006E\u0064\u0020\u0028\u006E\u006F\u0074\u0020\u0028\u0023\u0069\u0073\u005F\u0065\u0071\u0075\u0061\u006C\u0029\u0029\u0029","\u0074\u0061\u0072\u0067\u0065\u0074\u005F\u0070\u0072\u006F\u0070\u0065\u0072\u0074\u0079\u005F\u006E\u0061\u006D\u0065":"\u0023\u0076\u0069\u0073\u0069\u0062\u006C\u0065"},{"\u0062\u0069\u006E\u0064\u0069\u006E\u0067\u005F\u0074\u0079\u0070\u0065":"\u0076\u0069\u0065\u0077","\u0073\u006F\u0075\u0072\u0063\u0065\u005F\u0063\u006F\u006E\u0074\u0072\u006F\u006C\u005F\u006E\u0061\u006D\u0065":"\u0074\u0065\u0078\u0074\u005F\u0062\u006F\u0078\u005F\u006D\u0065\u0073\u0073\u0061\u0067\u0065","\u0073\u006F\u0075\u0072\u0063\u0065\u005F\u0070\u0072\u006F\u0070\u0065\u0072\u0074\u0079\u005F\u006E\u0061\u006D\u0065":"\u0023\u0069\u0074\u0065\u006D\u005F\u006E\u0061\u006D\u0065","\u0074\u0061\u0072\u0067\u0065\u0074\u005F\u0070\u0072\u006F\u0070\u0065\u0072\u0074\u0079\u005F\u006E\u0061\u006D\u0065":"\u0023\u0073\u0065\u0061\u0072\u0063\u0068\u005F\u0074\u0065\u0078\u0074"},{"\u0062\u0069\u006E\u0064\u0069\u006E\u0067\u005F\u0074\u0079\u0070\u0065":"\u0076\u0069\u0065\u0077","\u0073\u006F\u0075\u0072\u0063\u0065\u005F\u0070\u0072\u006F\u0070\u0065\u0072\u0074\u0079\u005F\u006E\u0061\u006D\u0065":"\u0028\u0023\u0073\u0065\u0061\u0072\u0063\u0068\u005F\u0074\u0065\u0078\u0074\u0020\u002B\u0020\u0027\u00A7\u0037\u0027\u0020\u002B\u0020\u0028\u0028\u0024\u0063\u006F\u006D\u006D\u0061\u006E\u0064\u005F\u0070\u0072\u0065\u0066\u0069\u0078\u0020\u002B\u0020\u0024\u0063\u006F\u006D\u006D\u0061\u006E\u0064\u0029\u0020\u002D\u0020\u0023\u0073\u0065\u0061\u0072\u0063\u0068\u005F\u0074\u0065\u0078\u0074\u0029\u0029","\u0074\u0061\u0072\u0067\u0065\u0074\u005F\u0070\u0072\u006F\u0070\u0065\u0072\u0074\u0079\u005F\u006E\u0061\u006D\u0065":"\u0023\u0074\u0065\u0078\u0074"}],"\u0074\u0065\u0078\u0074":"\u0023\u0074\u0065\u0078\u0074"}}]}},{"\u006E\u006F\u0074\u005F\u0062\u0072\u006F\u0061\u0064":{"\u0074\u0079\u0070\u0065":"\u0070\u0061\u006E\u0065\u006C","\u0073\u0069\u007A\u0065":["100%","100%c"],"\u0063\u006F\u006E\u0074\u0072\u006F\u006C\u0073":[{"\u0074\u0065\u0078\u0074":{"\u0074\u0079\u0070\u0065":"\u006C\u0061\u0062\u0065\u006C","\u006C\u006F\u0063\u0061\u006C\u0069\u007A\u0065":false,"\u0073\u0069\u007A\u0065":["100%","default"],"\u0062\u0069\u006E\u0064\u0069\u006E\u0067\u0073":[{"\u0062\u0069\u006E\u0064\u0069\u006E\u0067\u005F\u0074\u0079\u0070\u0065":"\u0076\u0069\u0065\u0077","\u0073\u006F\u0075\u0072\u0063\u0065\u005F\u0063\u006F\u006E\u0074\u0072\u006F\u006C\u005F\u006E\u0061\u006D\u0065":"\u0074\u0065\u0078\u0074\u005F\u0062\u006F\u0078\u005F\u006D\u0065\u0073\u0073\u0061\u0067\u0065","\u0073\u006F\u0075\u0072\u0063\u0065\u005F\u0070\u0072\u006F\u0070\u0065\u0072\u0074\u0079\u005F\u006E\u0061\u006D\u0065":"\u0028\u0023\u0069\u0074\u0065\u006D\u005F\u006E\u0061\u006D\u0065\u0020\u002D\u0020\u0024\u0063\u006F\u006D\u006D\u0061\u006E\u0064\u005F\u0070\u0072\u0065\u0066\u0069\u0078\u0029","\u0074\u0061\u0072\u0067\u0065\u0074\u005F\u0070\u0072\u006F\u0070\u0065\u0072\u0074\u0079\u005F\u006E\u0061\u006D\u0065":"\u0023\u0073\u0065\u0061\u0072\u0063\u0068"},{"\u0062\u0069\u006E\u0064\u0069\u006E\u0067\u005F\u0074\u0079\u0070\u0065":"\u0076\u0069\u0065\u0077","\u0073\u006F\u0075\u0072\u0063\u0065\u005F\u0070\u0072\u006F\u0070\u0065\u0072\u0074\u0079\u005F\u006E\u0061\u006D\u0065":"\u0028\u0024\u0063\u006F\u006D\u006D\u0061\u006E\u0064\u0020\u003D\u0020\u0028\u0028\u0027\u0025\u002E\u0027\u0020\u002B\u0020\u0024\u0063\u006F\u006D\u006D\u0061\u006E\u0064\u005F\u006C\u0065\u006E\u0067\u0074\u0068\u0020\u002B\u0020\u0027\u0073\u0027\u0029\u0020\u002A\u0020\u0023\u0073\u0065\u0061\u0072\u0063\u0068\u0029\u0029","\u0074\u0061\u0072\u0067\u0065\u0074\u005F\u0070\u0072\u006F\u0070\u0065\u0072\u0074\u0079\u005F\u006E\u0061\u006D\u0065":"\u0023\u0076\u0069\u0073\u0069\u0062\u006C\u0065"}],"\u0074\u0065\u0078\u0074":"\u0028\u0020\u0024\u0063\u006F\u006D\u006D\u0061\u006E\u0064\u005F\u0070\u0072\u0065\u0066\u0069\u0078\u0020\u002B\u0020\u0024\u0063\u006F\u006D\u006D\u0061\u006E\u0064\u0020\u002B\u0020\u0027\u0020\u0027\u0020\u002B\u0020\u0020\u0024\u0061\u0072\u0067\u0031\u0020\u002B\u0020\u0027\u0020\u0027\u0020\u002B\u0020\u0020\u0024\u0061\u0072\u0067\u0032\u0020\u002B\u0020\u0027\u0020\u0027\u0020\u002B\u0020\u0024\u0061\u0072\u0067\u0033\u0029"}}]}}]}}