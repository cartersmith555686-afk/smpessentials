{
  "namespace": "chest",

  "chest_label": {
    "text": "",
    "size": [ "100%c", "100%c" ],
    "$custom_container_name|default": "$container_title",

    "controls": [
      {
        "name_stack": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": [ "100%c", "100%cm" ],

          "controls": [
            {
              "container_label@ds_oe_inventory_viewer.title_label": {
                "text": "$custom_container_name"
              }
            }
          ]
        }
      }
    ]
  },

  "large_chest_panel_top_half": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "custom_inventory_grid@ds_oe_inventory_viewer.viewer_grid_panel": {
              "offset": [ 0, -2.5 ],
              "ignored": "(not $is_inventory_viewer)"
            }
          }
        ]
      }
    ]
  },

  "large_chest_panel_top_half/large_chest_grid": {
    "ignored": "$is_inventory_viewer"
  },

  "small_chest_screen": {
    "$container_name": "$container_title",
    "$is_inventory_viewer|default": false,

    "modifications": [
      {
        "array_name": "variables",
        "operation": "insert_back",
        "value": [
          {
            "requires": "(not ($container_name - '_oe_inv:' = $container_name))",
            "$screen_content": "chest.large_chest_panel",
            "$screen_bg_content": "common.screen_background",
            "$custom_container_name": "($container_name - ('%.9s' * $container_name))",
            "$is_inventory_viewer": true
          }
        ]
      }
    ]
  },

  "large_chest_screen": {
    "$container_name": "$container_title",
    "$is_inventory_viewer": false
  },

  "ender_chest_screen": {
    "$container_name": "$container_title",
    "$is_inventory_viewer": false
  },

  "shulker_box_screen": {
    "$container_name": "$container_title",
    "$is_inventory_viewer": false
  },

  "barrel_screen": {
    "$container_name": "$container_title",
    "$is_inventory_viewer": false
  }
}
