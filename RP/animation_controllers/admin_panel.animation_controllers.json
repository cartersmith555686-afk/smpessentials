{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.panel": {
			"initial_state": "closed",
			"states": {
				"closed": {
					"transitions": [
						{"open": "query.cooldown_time_remaining > 0.0"}
					]
				},
				"open": {
					"animations": [
						{"open_first": "c.is_first_person"},
						{"open_third": "!c.is_first_person"}
					],
					"transitions": [
						{"closing": "query.cooldown_time_remaining <= 0.0"}
					]
				},
				"closing": {
					"animations": [
						{"close_first": "c.is_first_person"},
						{"close_third": "!c.is_first_person"}
					],
					"transitions": [
						{"open": "query.cooldown_time_remaining > 0.0"},
						{"closed": "query.all_animations_finished"}
					]
				}
			}
		}
	}
}